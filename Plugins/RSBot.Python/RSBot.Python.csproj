<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputPath>.\..\..\Build\Data\Plugins</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Description>A open source bot for Silkroad Online</Description>
    <Copyright>Copyright © 2026 Silkroad Developer Community</Copyright>
    <PackageProjectUrl>https://github.com/Silkroad-Developer-Community/OasisBot</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Silkroad-Developer-Community/OasisBot</RepositoryUrl>
    <OutputType>Library</OutputType>
    <PythonVersion>3.13.11</PythonVersion>
    <PythonRuntimeDir>$(OutputPath)\..\Python\PyRuntime\</PythonRuntimeDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="pythonnet" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Botbases\RSBot.Training\RSBot.Training.csproj">
      <!-- Training is a Botbase, deployed to Build\Data\Bots by its own project - copying its
           DLL here too (Build\Data\Plugins, MSBuild's default for a ProjectReference) created a
           second, independent copy that silently went stale every time only RSBot.Training was
           rebuilt afterward. Assembly.LoadFrom resolves by simple name and reuses whichever
           same-named assembly loaded first (see BotbaseManager.GetExtensionsFromAssembly) - so
           whichever of the two loaded first (order not guaranteed) could "win" and shadow the
           other for the rest of that run, silently keeping edits to Training from ever taking
           effect regardless of how many times its own project was rebuilt. -->
      <Private>False</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\Library\RSBot.Core\RSBot.Core.csproj" />
    <ProjectReference Include="..\..\SDUI\SDUI\SDUI.csproj" />
    <ProjectReference Include="..\RSBot.General\RSBot.General.csproj" />
  </ItemGroup>

  <Target Name="DownloadPythonRuntime" BeforeTargets="Build">
    <PropertyGroup>
      <!-- Path to the python runtime directory (trimmed to avoid shell escaping issues) -->
      <PythonRuntimeDirFull>$([System.IO.Path]::GetFullPath('$(PythonRuntimeDir)').TrimEnd('\'))</PythonRuntimeDirFull>
    </PropertyGroup>

    <Message
      Importance="high"
      Text="[Python-Build] Looking for PythonRuntime at: $(PythonRuntimeDirFull)"
    />

    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\download_python.ps1&quot; -PythonVersion &quot;$(PythonVersion)&quot; -DestinationPath &quot;$(PythonRuntimeDirFull)&quot;" />

    <Message Importance="high" Text="[Python-Build] Python Check/Installation process finished." />
  </Target>
</Project>
