<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>RSBot</RootNamespace>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputPath>.\..\..\Build</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Description>A open source bot for Silkroad Online</Description>
    <Copyright>Copyright © 2018-2026 RSBot Team; 2026 Silkroad Developer Community</Copyright>
    <PackageProjectUrl>https://github.com/Silkroad-Developer-Community/RSBot</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Silkroad-Developer-Community/RSBot</RepositoryUrl>
    <AssemblyName>OasisBot</AssemblyName>
    <Title>OasisBot</Title>
    <Product>OasisBot</Product>
    <Company>Silkroad Developer Community</Company>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <InformationalVersion>2.10.0</InformationalVersion>
    <AssemblyVersion>2.10.0</AssemblyVersion>
    <PlatformTarget>x86</PlatformTarget>
    <UseWPF>False</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Library\RSBot.Core\RSBot.Core.csproj">
      <Private>True</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\SDUI\SDUI\SDUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="pythonnet" Version="3.0.5" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
  </ItemGroup>
  <Target Name="CopyDependencies" AfterTargets="Build">
    <ItemGroup>
      <DependencyFiles Include="..\..\Dependencies\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(DependencyFiles)" DestinationFolder="..\..\Build\Data\%(RecursiveDir)" />
  </Target>
  <Target Name="EnsureLogDirectories" AfterTargets="Build">
    <!-- User/Logs/... is only ever created on demand at runtime (RSBot.Log.Views.Main.AppendLog,
         RSBot.Core.Log.FatalFileOnly) - so a fresh checkout/CI build has no Logs folder at all
         until the app has actually logged something. Create the well-known subfolders up front
         so the file logs this app writes are always at a predictable, already-existing path
         instead of only appearing after the fact. scripts/build.ps1 -Clean already preserves an
         existing Build/User across a clean build (moves it out, then back), so this is purely
         additive - it never overwrites real log data, only fills in directories that don't exist. -->
    <ItemGroup>
      <LogDirectories Include="..\..\Build\User\Logs;..\..\Build\User\Logs\Environment;..\..\Build\User\Logs\Exceptions" />
    </ItemGroup>
    <MakeDir Directories="@(LogDirectories)" Condition="!Exists('%(LogDirectories.Identity)')" />
  </Target>
  <Target Name="RemoveUnusedRuntimeAssets" AfterTargets="Build">
    <!-- PlatformTarget above already hard-pins this whole app to x86, so only the win-x86
         SkiaSharp native asset is ever actually used - the other 3 RID variants (win-x64,
         win-arm64, osx) MSBuild still copies into Build/runtimes/ regardless (RID-specific asset
         trimming during a plain `dotnet build`/`msbuild` pass - what both the local dev build and
         the real CI release pipeline actually use - only fully applies at `dotnet publish` time,
         confirmed by testing: setting <RuntimeIdentifier> here did not trim them, and separately
         caused `dotnet build` to emit a whole second, fully-duplicated Build/win-x86/ output
         alongside Build/ itself, so it was removed again). Deleting the unused 3 explicitly
         instead. -->
    <ItemGroup>
      <UnusedRuntimeDirs Include="..\..\Build\runtimes\osx;..\..\Build\runtimes\win-arm64;..\..\Build\runtimes\win-x64" />
    </ItemGroup>
    <RemoveDir Directories="@(UnusedRuntimeDirs)" Condition="Exists('%(UnusedRuntimeDirs.Identity)')" />
  </Target>
  <Target Name="MoveDependenciesToLib" AfterTargets="Build">
    <!-- Keeps Build/'s root down to just OasisBot.{exe,dll,pdb,deps.json,runtimeconfig.json},
         Client.Library.dll (native, injected by a hardcoded path in ClientManager.cs - can't
         move), CommandLine.dll (see below), Data/, and User/. Every other managed dependency
         DLL/PDB the build copies to the output root goes into lib/ instead -
         Program.RegisterLibProbingPath() (a module initializer, so it's guaranteed to run before
         anything else in the app needs one of these) redirects assembly resolution there. A
         runtimeconfig.template.json + additionalProbingPaths was tried first as the documented,
         no-code way to do this, but didn't actually get merged into the generated
         runtimeconfig.json in this project's build setup. Botbase/Plugin projects build straight
         into Data/Bots and Data/Plugins with their own private dependency copies, so this doesn't
         touch or affect them. -->
    <ItemGroup>
      <!-- CommandLine.dll stays put: Program.Main() calls straight into CommandLine.Parser/
           ParserResult<T> in its own method body (not from inside a lambda or a call to another
           method), and the CLR must resolve every assembly Main()'s own JIT compilation touches
           through normal same-directory probing before it can even start running - confirmed by
           testing that this fails with a FileNotFoundException before Main's first line executes,
           regardless of any AssemblyLoadContext.Resolving/AppDomain.AssemblyResolve hook (both
           were tried; neither runs early enough to intercept it). Everything else Program.cs
           touches during startup is inside a lambda or a call to another method, both of which
           are JIT-compiled lazily on first actual invocation - by which point
           Program.RegisterLibProbingPath()'s module-initializer-registered resolver is already
           active and handles them fine. -->
      <DependencyDllsToMove
        Include="..\..\Build\*.dll;..\..\Build\*.pdb"
        Exclude="..\..\Build\OasisBot.dll;..\..\Build\OasisBot.pdb;..\..\Build\Client.Library.dll;..\..\Build\CommandLine.dll"
      />
    </ItemGroup>
    <MakeDir Directories="..\..\Build\lib" Condition="'@(DependencyDllsToMove)' != ''" />
    <Move SourceFiles="@(DependencyDllsToMove)" DestinationFolder="..\..\Build\lib" Condition="'@(DependencyDllsToMove)' != ''" />
  </Target>
  <Target
    Name="DownloadNavigationLinkage"
    AfterTargets="Build"
    Condition="!Exists('..\..\Build\Data\navigation_linkage.json')"
  >
    <PropertyGroup>
      <LinkageGzPath>..\..\Build\Data\navigation_linkage.json.gz</LinkageGzPath>
      <LinkageJsonPath>..\..\Build\Data\navigation_linkage.json</LinkageJsonPath>
    </PropertyGroup>
    <DownloadFile
      SourceUrl="https://github.com/Silkroad-Developer-Community/Silkroad-NavLink/releases/latest/download/navigation_linkage.json.gz"
      DestinationFolder="..\..\Build\Data"
      DestinationFileName="navigation_linkage.json.gz"
      SkipUnchangedFiles="true"
    />
    <Exec Command="powershell -Command &quot;Add-Type -AssemblyName System.IO.Compression; $i=[System.IO.File]::OpenRead('$(LinkageGzPath)'); $o=[System.IO.File]::Create('$(LinkageJsonPath)'); $g=[System.IO.Compression.GZipStream]::new($i, [System.IO.Compression.CompressionMode]::Decompress); $g.CopyTo($o); $g.Dispose(); $o.Dispose(); $i.Dispose(); Remove-Item '$(LinkageGzPath)' -Force&quot;" />
  </Target>
</Project>
