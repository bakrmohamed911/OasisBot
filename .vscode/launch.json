{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch OasisBot",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}\\Build\\OasisBot.exe",
            "args": [],
            "cwd": "${workspaceFolder}\\Build",
            "console": "internalConsole",
            "stopAtEntry": false,
            "justMyCode": false,
            "symbolSearchEnabled": true,
            "moduleLoadFilter": {
                "includedModules": [
                    "RSBot.Core.dll",
                    "OasisBot.exe"
                ]
            }
        }
    ]
}
